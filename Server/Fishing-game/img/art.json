"Шлем марлина"],"hat_dragon_helm":[16,16,"hat","Драконий шлем"],"outfit_rodmaster":[16,16,"outfit","Мундир мастера снастей"],"outfit_manta":[16,16,"outfit","Плащ-скат"],"pet_dragonet":[16,16,"pet","Дракончик Уголёк"],"bobber_anchor":[8,8,"bobber","Якорь"],"hat_master_crown":[16,16,"hat","Корона хозяина долины"],"outfit_legend_cloak":[16,16,"outfit","Плащ легенд"],"bobber_marlin":[8,8,"bobber","Марлин"],"bobber_kraken":[8,8,"bobber","Кракен"],"bobber_aurora":[8,8,"bobber","Северное сияние"],"bobber_millstone":[8,8,"bobber","Жёрнов"],"ui_coin":[8,8,"ui","coin"],"ui_xp":[16,16,"ui","xp"],"ui_level":[16,16,"ui","level"],"ui_fish":[16,16,"ui","fish"],"ui_trophy":[16,16,"ui","trophy"],"ui_map":[16,16,"ui","map"],"ui_shop":[16,16,"ui","shop"],"ui_book":[16,16,"ui","book"],"ui_star_gold":[8,8,"ui","star_gold"],"ui_star_iridium":[8,8,"ui","star_iridium"],"ui_heart":[16,16,"ui","heart"],"ui_house":[16,16,"ui","house"],"ui_boat":[16,16,"ui","boat"],"ui_axe":[16,16,"ui","axe"],"ui_pickaxe":[16,16,"ui","pickaxe"],"ui_seed":[16,16,"ui","seed"],"ui_chest":[16,16,"ui","chest"],"ui_clock":[16,16,"ui","clock"],"ui_sun":[16,16,"ui","sun"],"ui_moon":[16,16,"ui","moon"],"ui_rain":[16,16,"ui","rain"],"ui_leaders":[16,16,"ui","leaders"],"ui_expert_rod":[16,16,"ui","expert_rod"],"ui_rod":[16,16,"ui","rod"],"ui_bait":[16,16,"ui","bait"],"ui_wardrobe":[16,16,"ui","wardrobe"],"ui_treasure":[16,16,"ui","treasure"]},"fish":{"fish_crucian":["common",0,"Золотистый и неприхотливый. С него начинается путь любого рыбака."],"fish_roach":["common",0,"Шустрая серебристая рыбка с красными глазами. Клюёт почти весь день."],"fish_rotan":["common",0,"Большеротый обжора-головешка. Выходит на охоту в сумерках."],"fish_perch":["uncommon",0,"Полосатый разбойник пруда. Бросается на наживку резко и без раздумий."],"fish_tench":["uncommon",0,"Скользкий и неторопливый. Любит тихие рассветы и вечера у камышей."],"fish_carp":["rare",0,"Крупный и упрямый. Живёт на глубине и не сдаётся без долгого боя."],"fish_tsar_carp":["legendary",0,"Говорят, он старше самой деревни. Чешуя сияет, как червонное золото."],"fish_bleak":["common",0,"Крошечная и юркая. Держится стайкой у самой поверхности."],"fish_chub":["common",0,"Лобастый и осторожный. Обожает жуков, упавших в воду с веток."],"fish_crayfish":["uncommon",0,"Пятится назад и больно щиплется. Выползает из нор, когда темнеет."],"fish_bream":["uncommon",0,"Широкий, как сковорода. Неспешно кормится на дне тихих омутов."],"fish_pike":["rare",0,"Зубастая хозяйка реки. Часами караулит добычу в засаде у коряг."],"fish_zander":["rare",0,"Клыкастый ночной охотник. Его глаза светятся в тёмной воде."],"fish_silver_sturgeon":["legendary",0,"Древняя рыба в костяной броне. Поднимается из глубин только в дождь."],"fish_grayling":["common",0,"Щёголь горных вод с огромным пёстрым спинным плавником."],"fish_brook_trout":["common",0,"Любит ледяную воду и быстрое течение. Бока усыпаны красными крапинками."],"fish_char":["uncommon",0,"Морозостойкий родич форели с огненно-оранжевым брюшком."],"fish_lenok":["rare",0,"Бронзовый хищник перекатов. Схватив наживку, сразу уходит в глубину."],"fish_taimen":["epic",0,"Гроза горных озёр с алым хвостом. Настоящие великаны берут в ненастье."],"fish_crystal_trout":["legendary",0,"Прозрачна, как талый лёд. Показывается лишь в лучах ясного утра."],"fish_mackerel":["common",0,"Стремительная и полосатая. Ходит у причала огромными косяками."],"fish_flounder":["common",0,"Плоская рыба, оба глаза которой смотрят в небо. Прячется в песке."],"fish_sea_bass":["uncommon",0,"Ярко-красный и колючий. Держится у камней под причалом."],"fish_squid":["uncommon",0,"Десять щупалец и облако чернил. По ночам поднимается к огням причала."],"fish_pufferfish":["rare",0,"При опасности раздувается в колючий шар. Греется у поверхности в ясные дни."],"fish_tuna":["epic",0,"Стальная торпеда открытого моря. Способен утащить за собой лодку."],"fish_giant_angler":["legendary",0,"Во тьме мерцает приманка-фонарик, а за ней — пасть размером с бочку."],"fish_loach":["common",0,"Скользкий, как мыло. Перед грозой беспокойно мечется у поверхности."],"fish_mudskipper":["common",0,"Рыба, которая гуляет по грязи на плавниках и умеет моргать."],"fish_eel":["uncommon",0,"Длинный и изворотливый. Выползает из ила, едва стемнеет."],"fish_snakehead":["uncommon",0,"Дышит воздухом и может проползти по суше до соседнего болота."],"fish_catfish":["rare",0,"Усатый великан болотных ям. Выходит на охоту, когда идёт дождь."],"fish_gar":["epic",0,"Живое ископаемое: чешуя крепче брони, а зубы — как у ящера."],"fish_fog_serpent":["legendary",0,"Болотная легенда. Его видят лишь в ночном тумане — и то не все."],"fish_sparkfin":["common",0,"Мальки, что искрятся в лаве, словно угольки в костре."],"fish_fire_perch":["common",0,"Плавники полыхают настоящим пламенем. Голыми руками не брать!"],"fish_obsidian_crab":["uncommon",0,"Панцирь из чёрного вулканического стекла, клешни раскалены докрасна."],"fish_lava_eel":["rare",0,"Плавает в расплавленном камне, будто в тёплой ванне."],"fish_magma_puffer":["epic",0,"Раздувается, набирая раскалённый газ. Лучше его не злить."],"fish_zhar_ryba":["legendary",0,"Родня сказочной Жар-птицы. Одна её чешуйка стоит целого состояния."],"fish_rudd":["common",0,"Золотистая, с ярко-красными плавниками. Греется у кувшинок в тёплый полдень."],"fish_asp":["uncommon",0,"Речной хищник-торпеда. Бьёт по малькам с разгона — брызги летят до самого берега."],"fish_whitefish":["uncommon",0,"Серебристый житель холодных глубин. Подходит к берегу только на утренней заре."],"fish_flying_fish":["uncommon",0,"Расправляет плавники-крылья и перелетает над волнами. Ловится только в ясный день."],"fish_bowfin":["rare",0,"Живое ископаемое с длинным спинным плавником. Дышит воздухом и охотится только ночью."],"fish_basalt_carp":["uncommon",0,"Чешуя тёмная и твёрдая, как застывшая лава, а в щелях между пластинами тлеет огонь."],"fish_horse_mackerel":["common",0,"Стайная рыба гавани с колючей «дорожкой» вдоль бока. Клюёт жадно — только успевай."],"fish_sea_burbot":["rare",0,"Скользкий донный житель с усом на подбородке. В темноте выходит из-под свай пирса."],"fish_blind_char":["uncommon",0,"Бледный, почти прозрачный и без глаз. Находит наживку по малейшему движению воды."],"fish_cave_gudgeon":["common",0,"Усатая крошка подземного озера. Пятнышки на боках слабо светятся в темноте."],"efish_barracuda":["rare",1,"Морская щука с зубами-иглами. Бросается на всё, что блестит."],"efish_king_mackerel":["rare",1,"Стремительная и полосатая, ходит стаями у самой поверхности."],"efish_giant_bass":["epic",1,"Огромный пятнистый окунь. Прячется в тени пирса и глотает добычу целиком."],"efish_swordfish":["epic",1,"Её меч рассекает волну. Выходит, когда море неспокойно."],"efish_stingray":["epic",1,"Плоский, как блюдо, с ядовитым шипом на хвосте. Зарывается в песок."],"efish_sunfish":["epic",1,"Круглая, как луна, греется у поверхности в тихую погоду. Пуглива."],"efish_sailfish":["epic",1,"Самая быстрая рыба моря. Поднимает спинной парус, когда идёт на рывок."],"efish_moray":["epic",1,"Живёт в щелях между старыми сваями и выходит на охоту по ночам."],"efish_seadragon":["epic",1,"Похож на обрывок водоросли. Приплывает с вечерним приливом."],"efish_blind_catfish":["rare",1,"Глаз у него нет — охотится на ощупь длинными усами."],"efish_cave_grayling":["rare",1,"Бледный хариус с огромным спинным плавником. Чуток к каждому шороху."],"efish_stone_char":["epic",1,"Серый, как пещерный камень, — пока не шевельнётся, не заметишь."],"efish_crystal_eel":["epic",1,"Прозрачный, как горный хрусталь. Ночью в свете поплавка переливается радугой."],"efish_proteus":["epic",1,"«Человеческая рыбка»: розовая, с пушистыми жабрами. Живёт сто лет и пугается грубой снасти."],"efish_glow_perch":["epic",1,"Полосы светятся голубым. Плывёт на свет, как мотылёк."],"efish_mica_carp":["epic",1,"Чешуя из слюдяных пластин. Кормится у подводного ключа, где вода несёт крошку."],"efish_cave_sturgeon":["epic",1,"Древний, как сама пещера. Поднимается из глубины только за глубинным червём."],"elegend_marlin":["legendary",1,"Властелин штормового моря. Говорят, он сам выбирает рыбака."],"elegend_harbor":["legendary",1,"Огромный старый групер. Живёт под сваями дольше, чем стоит сам Город."],"elegend_ghostray":["legendary",1,"Белый, почти прозрачный скат. Скользит под водой только в утреннем тумане."],"elegend_patriarch":["legendary",1,"Сом-исполин, старший в подземном озере. Слышит, как падает каждая капля."],"elegend_giant":["legendary",1,"Осётр, обросший каменной бронёй. Стоит в струе подводного ключа, как скала."],"elegend_dragon":["legendary",1,"Живой хрусталь с плавниками-крыльями. Кто его видел, говорят, видел всё."],"fish_ruffe":["common",0,"Колючий и вечно голодный. Первым приплывает на запах прикормки."],"fish_ide":["common",0,"Серебристый, с красноватыми плавниками. Днём охотно бросается на блесну."],"fish_rainbow_trout":["uncommon",0,"Ловится утром в быстрой воде у колеса — почти только на мушки. Бока переливаются радугой."],"fish_burbot":["uncommon",0,"Ночной житель холодной воды. Любит выползков, а в дождь клюёт вдвое охотнее."],"fish_wild_carp":["rare",0,"Дикий предок карпа, крупночешуйчатый и сильный. Вечером идёт на тесто и хлебную прикормку."],"fish_grass_carp":["rare",0,"Травоядный великан пруда. Днём не устоит перед пучком свежего тростника."],"fish_sterlet":["epic",0,"Царская рыба с костяными жучками на спине. Живёт только в глубоком Омуте за плотиной."],"fish_mill_master":["legendary",0,"Старый сом-водяной из-под мельничного колеса. Говорят, это он крутит жернова по ночам."]},"locations":{"pond":{"name":"Деревенский пруд","desc":"Тихий пруд у самой деревни, заросший камышом и кувшинками. Лучшее место, чтобы научиться рыбачить.","min_level":1,"img":"loc/pond.webp","w":420,"h":340},"river":{"name":"Лесная река","desc":"Быстрая река среди старых елей. В омутах караулят добычу щуки, а на перекатах играют голавли.","min_level":2,"img":"loc/river.webp","w":420,"h":340},"mountain":{"name":"Горное озеро","desc":"Ледяное прозрачное озеро у подножия снежных вершин. Дом хариуса, гольца и грозного тайменя.","min_level":3,"img":"loc/mountain.webp","w":420,"h":340},"ocean":{"name":"Морской причал","desc":"Солёный ветер, крики чаек и длинный причал над морской глубиной. Здесь клюют настоящие гиганты.","min_level":5,"img":"loc/ocean.webp","w":420,"h":340},"swamp":{"name":"Туманное болото","desc":"Мрачное болото в вечном тумане. Говорят, в его чёрных омутах живёт нечто очень древнее.","min_level":7,"img":"loc/swamp.webp","w":420,"h":340},"volcano":{"name":"Вулканическое озеро","desc":"Озеро кипящей лавы в жерле спящего вулкана. Нужна железная выдержка — и жаропрочная леска!","min_level":9,"img":"loc/volcano.webp","w":420,"h":340},"city":{"name":"Город","desc":"Шумный порт за морем: пирс, лавки, бутик и доска заданий. Экспертная зона — здесь клюёт элитная рыба.","min_level":10,"img":"loc/city.webp","w":420,"h":340},"cave":{"name":"Пещера","desc":"Тёмные своды за завалами на окраине Города: подземное озеро, капель и валуны с твёрдой породой.","min_level":12,"img":"loc/cave.webp","w":420,"h":340},"mill":{"name":"Старая мельница","desc":"Мельничная запруда за лесом: водяное колесо, бобровые хатки и утренний туман. Почините мостик через ручей, мельницу и помогите бобрам достроить плотину — за ней откроется глубокий Омут.","min_level":10,"img":"loc/mill.webp","w":420,"h":340}},"sprites":["bobber_0","bobber_1","char_down_cast_release_0","char_down_cast_windup_0","char_down_fish_wait_0","char_down_fish_wait_1","char_down_hold_fish_0","char_down_idle_0","char_down_idle_1","char_down_reel_0","char_down_reel_1","char_down_walk_0","char_down_walk_1","char_down_walk_2","char_down_walk_3","char_right_idle_0","char_right_idle_1","char_right_walk_0","char_right_walk_1","char_right_walk_2","char_right_walk_3","chest_0","chest_1","pet_cat_walk_0","pet_cat_walk_1","pet_cat_walk_2","pet_cat_walk_3"],"gameplay":{"webp":"gameplay.webp","gif":"gameplay.gif","poster":"gameplay_poster.webp","w":360,"h